rules_version = '2';

// =============================================================================
// Firestore Security Rules — BPML CKD Clinic
// ใช้ Firebase Authentication (email/password) → request.auth ไม่เป็น null
// เมื่อ user login สำเร็จ
//
// วิธี deploy:
//   firebase deploy --only firestore:rules
//
// หมายเหตุ: rules นี้กัน unauthorized read/write จากนอกแอป
// แต่ไม่แยก role (admin/pharmacist) ระดับ DB — role enforcement
// ทำใน client logic (settings.jsx, app.jsx)
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ข้อมูลผู้ป่วย — เข้าถึงได้เฉพาะ user ที่ login ผ่าน Firebase Auth แล้ว
    match /pharm_ckd_records/{doc} {
      allow read, write: if request.auth != null;
    }

    // บัญชีผู้ใช้ — เข้าถึงได้เฉพาะ user ที่ login
    match /pharm_ckd_users/{doc} {
      allow read, write: if request.auth != null;
    }

    // audit log การลบ — เข้าถึงได้เฉพาะ user ที่ login
    match /pharm_ckd_delete_log/{doc} {
      allow read, write: if request.auth != null;
    }

    // ปฏิเสธ collection อื่นทั้งหมด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
